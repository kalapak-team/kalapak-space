APP_NAME="Kalapak Code Team"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API (production)
# CORS_ALLOWED_ORIGINS=https://kalapak-team.space,https://www.kalapak-team.space

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Docker Compose: hostname "postgres" works only inside containers. Run migrations with:
#   docker compose exec backend php artisan migrate
# (from repo root, with postgres + backend up). Do not change this to 127.0.0.1 if backend/.env
# is mounted into the backend container — that would break DB from inside the container.
# Local Docker Compose (not production)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kalapak_db
DB_USERNAME=kalapak_user
DB_PASSWORD=kalapak123
# Production (Aiven example — set secrets in Render, never commit passwords):
# DB_HOST=kalapak-db-kalapak-space.j.aivencloud.com
# DB_PORT=16826
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=
# DB_SSLMODE=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# Local/default: prefer (works with non-SSL postgres). Set to require for managed DBs that enforce TLS.
DB_SSLMODE=prefer

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
# Production (Upstash): ALLOW_REDIS=1, CACHE_STORE=redis, SESSION_DRIVER=redis, QUEUE_CONNECTION=redis
# PUBLIC_API_CACHE_TTL=3600
# REDIS_CLIENT=predis
# REDIS_SCHEME=tls
# REDIS_HOST=humorous-flounder-79841.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_upstash_password
# Or: REDIS_URL=rediss://default:PASSWORD@humorous-flounder-79841.upstash.io:6379
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:3000

MAIL_MAILER=resend
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM_ADDRESS=noreply@kalapak-team.space
MAIL_FROM_NAME="Kalapak Code Team"

# Supabase Storage (S3-compatible) — required for blog/team/project images.
# Create a project at https://supabase.com, add a public bucket named kalapak-assets,
# then set these in Render. If you replace a deleted project, run:
#   php artisan storage:remap-supabase-urls
SUPABASE_ENDPOINT=https://YOUR_PROJECT_ID.supabase.co/storage/v1/s3
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ACCESS_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_BUCKET=kalapak-assets
# Optional — only for permanently deleted Supabase projects (leave empty if project is just paused).
# SUPABASE_DEAD_HOSTS=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=0x4AAAAAAAC4BOcvt_5BMWUI3JaB4D7dEArs

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.kalapak-team.space/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.kalapak-team.space/auth/github/callback

# Production (custom domain)
# APP_URL=https://api.kalapak-team.space
# FRONTEND_URL=https://kalapak-team.space
# SITE_URL=https://kalapak-team.space
# CORS_ALLOWED_ORIGINS=https://kalapak-team.space,https://www.kalapak-team.space
# SANCTUM_STATEFUL_DOMAINS=kalapak-team.space,www.kalapak-team.space
