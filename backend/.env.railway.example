# ── Copy into Railway → Service → Variables (kalapak backend) ──
# Do NOT commit real secrets. Use Aiven + Upstash values from your consoles.
# After pasting, run deploy; then: railway run php artisan migrate --force

APP_NAME="Kalapak Team"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_OR_COPY_FROM_RENDER
APP_URL=https://api.kalapak-team.space

FRONTEND_URL=https://kalapak-team.space
SITE_URL=https://kalapak-team.space
CORS_ALLOWED_ORIGINS=https://kalapak-team.space,https://www.kalapak-team.space

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Migrations on boot (same as docker-entrypoint when APP_ENV=production)
RUN_MIGRATIONS=1
MIGRATE_DELAY_SECONDS=0

# ── Aiven PostgreSQL ──
DB_CONNECTION=pgsql
DB_HOST=kalapak-db-kalapak-space.j.aivencloud.com
DB_PORT=16826
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD
DB_SSLMODE=require
DATABASE_URL=postgresql://avnadmin:YOUR_AIVEN_PASSWORD@kalapak-db-kalapak-space.j.aivencloud.com:16826/defaultdb?sslmode=require

# ── Upstash Redis (TCP + TLS — not REST URL) ──
ALLOW_REDIS=1
REDIS_CLIENT=predis
REDIS_SCHEME=tls
REDIS_HOST=humorous-flounder-79841.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_UPSTASH_PASSWORD
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@humorous-flounder-79841.upstash.io:6379

CACHE_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.kalapak-team.space
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=kalapak-team.space,www.kalapak-team.space,api.kalapak-team.space

PUBLIC_API_CACHE_TTL=3600

FILESYSTEM_DISK=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ENDPOINT=https://YOUR_PROJECT.supabase.co/storage/v1/s3
SUPABASE_REGION=ap-southeast-1
SUPABASE_BUCKET=kalapak-assets
SUPABASE_ACCESS_KEY=
SUPABASE_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=no-reply@kalapak-team.space
MAIL_FROM_NAME="Kalapak Team"
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.kalapak-team.space/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.kalapak-team.space/auth/github/callback

TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Railway sets PORT automatically — docker-entrypoint uses PORT for artisan serve
